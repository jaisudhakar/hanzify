{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- assign gift_balance = gift_card.balance | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_balance, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main id="main" class="gift-card container">
      <p class="label">{{ shop.name | escape }}</p>
      <h1 class="display h2">{{ 'gift_cards.issued.subtext' | t }}</h1>
      <div class="gift-card__card">
        {{ 'gift-card/card.svg' | shopify_asset_url | image_tag: alt: '', class: 'gift-card__img', width: 570, height: 356 }}
        <p class="gift-card__amount">{{ gift_card.initial_value | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}<p class="label label--muted">{{ 'gift_cards.issued.remaining_html' | t: balance: gift_balance }}</p>{%- endif -%}
        {%- if gift_card.expired or gift_card.enabled != true -%}<p class="label">{{ 'gift_cards.issued.expired' | t }}</p>{%- endif -%}
        {%- if gift_card.expires_on -%}<p class="label label--muted">{%- assign expires = gift_card.expires_on | date: '%B %e, %Y' -%}{{ 'gift_cards.issued.expiration_date' | t: expires_on: expires }}</p>{%- endif -%}
      </div>
      <div class="gift-card__qr" id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <div class="gift-card__code">
        <input class="field" type="text" value="{{ gift_card.code | format_code }}" readonly aria-label="{{ 'gift_cards.issued.gift_card_code' | t }}" id="GiftCardCode">
        <button class="btn btn--outline" type="button" onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('GiftCardCode').value); this.textContent={{ 'gift_cards.issued.copy_code_success' | t | json | escape }};">{{ 'gift_cards.issued.copy_code' | t }}</button>
      </div>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="gift-card__wallet"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy"></a>
      {%- endif -%}
      <div class="gift-card__actions">
        <a class="btn" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button class="btn btn--outline" type="button" onclick="window.print();">{{ 'gift_cards.issued.print_gift_card' | t }}</button>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120, imageAltText: {{ 'gift_cards.issued.qr_image_alt' | t | json }} });
      });
    </script>
  </body>
</html>
