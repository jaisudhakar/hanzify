{%- liquid
  assign heading = section.settings.heading
  if heading contains '[collection]'
    assign heading = heading | replace: '[collection]', product.collections.first.title
  endif
-%}
<section class="section section--tight-top color-{{ section.settings.color_scheme }}" data-slider-root data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<div class="section-head__index label"><b>{{ section.settings.eyebrow | escape }}</b></div>{%- endif -%}
          <h2 class="display h3">{{ heading | escape }}</h2>
        </div>
        <div class="section-head__actions">
          <div class="slider-arrows">
            <button class="slider-arrow" type="button" data-slider-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', icon: 'prev' %}</button>
            <button class="slider-arrow" type="button" data-slider-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', icon: 'arrow' %}</button>
          </div>
        </div>
      </div>
      <div class="slider" data-slider-track role="list">
        {%- for p in recommendations.products -%}
          <div role="listitem">{% render 'product-card', card_product: p, index: forloop.index0 %}</div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "section-related",
  "settings": [
    { "type": "paragraph", "content": "Recommendations are generated automatically and improve over time. Customize them with the Search & Discovery app." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You may also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More from [collection]", "info": "Use [collection] to insert the product's first collection." },
    { "type": "select", "id": "intent", "label": "Type", "options": [{ "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary" }], "default": "related" },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 8 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Product recommendations" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
