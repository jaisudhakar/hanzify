<section class="page-hero">
  <div class="container page-hero__inner">
    <div>
      <nav class="breadcrumbs label" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span>{{ 'sections.cart.title' | t }}</span></nav>
      <h1 class="display h1">{{ 'sections.cart.title' | t }}</h1>
    </div>
  </div>
</section>
<section class="section" data-cart-page>
  <div class="container">
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-page">
        <div class="cart-page__items" data-cart-items>
          {%- for item in cart.items -%}
            {%- render 'cart-line-item', item: item, index: forloop.index -%}
          {%- endfor -%}
        </div>
        <aside class="cart-page__summary">
          {%- render 'ship-meter' -%}
          {%- if settings.cart_notes -%}
            <label class="label" for="CartNote">{{ 'sections.cart.note' | t }}</label>
            <textarea class="field" id="CartNote" name="note" rows="3" data-cart-note>{{ cart.note }}</textarea>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-subtotal cart-subtotal--discount"><span>{{ discount.title | escape }}</span><span>-{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="cart-subtotal"><span>{{ 'sections.cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
          <p class="cart-note">
            {%- if cart.duties_included and cart.taxes_included -%}
              {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout' | t }}
            {%- elsif cart.taxes_included -%}
              {{ 'sections.cart.taxes_included_shipping_at_checkout' | t }}
            {%- else -%}
              {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
            {%- endif -%}
          </p>
          <button class="btn btn--block" type="submit" name="checkout">{{ 'sections.cart.checkout' | t }} {% render 'icon', icon: 'arrow' %}</button>
          <noscript><button class="btn btn--outline btn--block" type="submit" name="update" style="margin-top:10px">{{ 'sections.cart.update' | t }}</button></noscript>
          {%- if additional_checkout_buttons -%}
            <div class="cart-page__dynamic">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </aside>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <p>{{ 'sections.cart.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }} {% render 'icon', icon: 'arrow' %}</a>
        {%- if shop.customer_accounts_enabled and customer == null -%}
          <p class="cart-empty__login">{{ 'sections.cart.login_html' | t: link: routes.account_login_url }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
