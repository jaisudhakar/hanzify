{%- if predictive_search.performed -%}
  {%- liquid
    assign res = predictive_search.resources
    assign total = res.products.size | plus: res.collections.size | plus: res.pages.size | plus: res.articles.size
  -%}
  <div class="predictive" data-predictive-results>
    {%- if res.queries.size > 0 -%}
      <div class="search-panel__hint">
        <span class="label label--muted">{{ 'templates.search.suggestions' | t }}</span>
        {%- for q in res.queries -%}
          <a class="chip" href="{{ q.url }}">{{ q.styled_text }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if res.products.size > 0 -%}
      <p class="label label--muted predictive__label">{{ 'templates.search.products' | t }}</p>
      <div class="grid">
        {%- for p in res.products -%}
          {%- render 'product-card', card_product: p, index: forloop.index0, sizes: '(min-width: 1200px) 15vw, (min-width: 750px) 30vw, 48vw' -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if res.collections.size > 0 or res.pages.size > 0 or res.articles.size > 0 -%}
      <div class="predictive__links">
        {%- for c in res.collections -%}<a class="chip" href="{{ c.url }}">{{ c.title | escape }}</a>{%- endfor -%}
        {%- for pg in res.pages -%}<a class="chip" href="{{ pg.url }}">{{ pg.title | escape }}</a>{%- endfor -%}
        {%- for a in res.articles -%}<a class="chip" href="{{ a.url }}">{{ a.title | escape }}</a>{%- endfor -%}
      </div>
    {%- endif -%}

    {%- if total == 0 and res.queries.size == 0 -%}
      <p class="empty-state">{{ 'templates.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- else -%}
      <a class="btn btn--outline predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last">
        {{ 'templates.search.view_all' | t: terms: predictive_search.terms }} {% render 'icon', icon: 'arrow' %}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
