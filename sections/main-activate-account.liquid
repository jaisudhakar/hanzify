<section class="section">
  <div class="container">
    <div class="account-form">
      <h1 class="display h2">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="cart-note">{{ 'customer.activate_account.subtext' | t }}</p>
      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}<div class="errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
        <input class="field" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
        <label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input class="field" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
        <button class="btn btn--block" type="submit">{{ 'customer.activate_account.submit' | t }}</button>
        <button class="btn btn--outline btn--block" type="submit" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
