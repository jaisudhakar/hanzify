<section class="section">
  <div class="container">
    <div class="account-form">
      <h1 class="display h2">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<div class="errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input class="field" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" value="{{ form.first_name }}">
        <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input class="field" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" value="{{ form.last_name }}">
        <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input class="field" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" value="{{ form.email }}" required>
        <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <input class="field" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
        <button class="btn btn--block" type="submit">{{ 'customer.register.submit' | t }}</button>
        <a class="link-underline" href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Customer register", "settings": [] }
{% endschema %}
