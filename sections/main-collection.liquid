{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign hero_image = collection.image | default: section.settings.fallback_image
  assign type_filter = nil
  for filter in collection.filters
    if filter.param_name == 'filter.p.product_type'
      assign type_filter = filter
    endif
  endfor
  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
-%}
<div class="collection-page" data-collection-root data-section-id="{{ section.id }}">
  {%- if section.settings.show_hero -%}
    <section class="page-hero page-hero--image" data-nav-dark>
      <div class="page-hero__bg">
        {%- render 'media-image', image: hero_image, demo: 'demo-banner-brutalist.webp', alt: collection.title, sizes: '100vw', width: 1672, height: 941, lazy: false, fallback: 'collection-1' -%}
      </div>
      <div class="container page-hero__inner">
        <div>
          <nav class="breadcrumbs label" aria-label="{{ 'general.breadcrumbs' | t }}">
            <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span>{{ collection.title | escape }}</span>
          </nav>
          {%- if section.settings.eyebrow != blank -%}<span class="label">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          <h1 class="display h1" style="margin-top:14px">{{ collection.title | escape }}</h1>
        </div>
        {%- if collection.description != blank -%}<div class="lead rte">{{ collection.description }}</div>{%- endif -%}
      </div>
    </section>
  {%- else -%}
    <section class="page-hero">
      <div class="container page-hero__inner">
        <div>
          <nav class="breadcrumbs label" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span>{{ collection.title | escape }}</span></nav>
          <h1 class="display h1">{{ collection.title | escape }}</h1>
        </div>
        {%- if collection.description != blank -%}<div class="lead rte">{{ collection.description }}</div>{%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="toolbar">
      <div class="container toolbar__inner">
        <div class="tabs" role="list">
          {%- if section.settings.show_type_tabs and type_filter != blank and type_filter.values.size > 1 -%}
            <a role="listitem" class="tab{% if type_filter.active_values.size == 0 %} is-active{% endif %}" href="{{ collection.url }}?sort_by={{ sort_by }}" data-facet-link>
              {{- 'sections.collection.all' | t }}<sup>{{ collection.all_products_count }}</sup>
            </a>
            {%- for value in type_filter.values -%}
              {%- if value.count > 0 or value.active -%}
                <a role="listitem" class="tab{% if value.active %} is-active{% endif %}" href="{{ collection.url }}?{{ value.param_name }}={{ value.value | url_encode }}&sort_by={{ sort_by }}" data-facet-link>
                  {{- value.label | escape }}<sup>{{ value.count }}</sup>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if collection.filters.size > 0 and section.settings.enable_filtering -%}
            <button type="button" class="tab tab--filter" data-open="facets-drawer" aria-controls="facets-drawer">
              {%- render 'icon', icon: 'filter' %} {{ 'sections.collection.filter' | t }}{% if active_count > 0 %}<sup>{{ active_count }}</sup>{% endif -%}
            </button>
          {%- endif -%}
        </div>
        <div class="toolbar__right">
          <span class="label label--muted" data-col-count>{{ 'sections.collection.product_count' | t: count: collection.products_count }}</span>
          {%- if section.settings.enable_sorting -%}
            <div class="select">
              <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'sections.collection.sort_by' | t }}</label>
              <select id="SortBy-{{ section.id }}" name="sort_by" data-sort-select>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
              </select>
              {%- render 'icon', icon: 'chev' -%}
            </div>
          {%- endif -%}
          <div class="grid-toggle">
            <button type="button" data-grid-cols="2" aria-label="{{ 'sections.collection.columns' | t: count: 2 }}">{% render 'icon', icon: 'grid2' %}</button>
            <button type="button" class="is-active" data-grid-cols="{{ section.settings.columns }}" aria-label="{{ 'sections.collection.columns' | t: count: section.settings.columns }}">{% render 'icon', icon: 'grid4' %}</button>
          </div>
        </div>
      </div>
    </div>

    {%- if active_count > 0 -%}
      <div class="container active-facets">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value or filter.max_value.value -%}
              <a class="chip" href="{{ filter.url_to_remove }}" data-facet-link>
                {{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }} {% render 'icon', icon: 'close' %}
              </a>
            {%- endif -%}
          {%- else -%}
            {%- for value in filter.active_values -%}
              <a class="chip" href="{{ value.url_to_remove }}" data-facet-link>{{ filter.label | escape }}: {{ value.label | escape }} {% render 'icon', icon: 'close' %}</a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        <a class="chip chip--clear" href="{{ collection.url }}?sort_by={{ sort_by }}" data-facet-link>{{ 'sections.collection.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    <section class="container collection-grid">
      {%- if collection.products.size > 0 -%}
        <div class="grid" data-col-grid style="--cols: {{ section.settings.columns }}">
          {%- for p in collection.products -%}
            {%- if forloop.index <= 4 -%}
              {%- render 'product-card', card_product: p, index: forloop.index0, lazy: false -%}
            {%- else -%}
              {%- render 'product-card', card_product: p, index: forloop.index0 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="empty-state">
          {%- if active_count > 0 -%}
            <p>{{ 'sections.collection.empty_filtered' | t }}</p>
            <p style="margin-top:20px"><a class="btn btn--outline" href="{{ collection.url }}" data-facet-link>{{ 'sections.collection.clear_all' | t }}</a></p>
          {%- else -%}
            <p>{{ 'sections.collection.empty' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- render 'pagination', paginate: paginate -%}
    </section>
  {%- endpaginate -%}

  {%- assign other = linklists[section.settings.other_menu] -%}
  {%- if other.links.size > 0 -%}
    <section class="container other-collections">
      <div class="section-head__index label"><b>{{ section.settings.other_heading | escape }}</b></div>
      <div class="tabs">
        {%- for link in other.links -%}
          <a class="tab tab--link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.enable_filtering -%}
    {%- render 'facets', results: collection, sort_by: sort_by -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "class": "section-main-collection",
  "settings": [
    { "type": "checkbox", "id": "show_hero", "label": "Show image banner", "default": true },
    { "type": "image_picker", "id": "fallback_image", "label": "Fallback banner image", "info": "Used when the collection has no image." },
    { "type": "text", "id": "eyebrow", "label": "Banner eyebrow", "default": "Collection" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true, "info": "Customize filters with the Shopify Search & Discovery app." },
    { "type": "checkbox", "id": "show_type_tabs", "label": "Show product type tabs", "default": true, "info": "Requires a Product type filter in Search & Discovery." },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },
    { "type": "header", "content": "Other collections" },
    { "type": "link_list", "id": "other_menu", "label": "Menu" },
    { "type": "text", "id": "other_heading", "label": "Heading", "default": "Other collections" }
  ]
}
{% endschema %}
