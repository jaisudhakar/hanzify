{%- liquid
  assign link = section.settings.link | default: settings.social_instagram_link
  assign demo_tiles = 'demo-ig-4.webp,demo-ig-5.webp,demo-ig-7.webp,demo-ig-2.webp,demo-ig-1.webp,demo-ig-3.webp,demo-ig-6.webp' | split: ','
-%}
<section class="ig color-{{ section.settings.color_scheme }}" aria-label="{{ section.settings.heading | escape }}" style="--marquee-speed: {{ section.settings.speed }}s">
  <div class="ig__head">
    <div>
      {%- if section.settings.heading != blank -%}<h2 class="ig__handle">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="ig__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank and link != blank -%}
      <a class="btn-solid" href="{{ link }}" target="_blank" rel="noopener">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="marquee ig__track">
      {%- for pass in (1..2) -%}
        <div class="marquee__group"{% if pass == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- assign demo_index = forloop.index0 | modulo: 7 -%}
            {%- assign tile_link = block.settings.link | default: link -%}
            <a class="ig__tile" {% if tile_link != blank %}href="{{ tile_link }}" target="_blank" rel="noopener"{% endif %}{% if pass == 2 %} tabindex="-1"{% endif %} {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- render 'media-image', image: block.settings.image, demo: demo_tiles[demo_index], alt: block.settings.caption, sizes: '(min-width: 750px) 28vw, 68vw', widths: '360, 540, 720, 1000', width: 800, height: 993, fallback: 'lifestyle-1' -%}
              {%- if block.settings.caption != blank -%}<span>{{ block.settings.caption | escape }}</span>{%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Social gallery",
  "tag": "div",
  "class": "section-ig",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "@HANZIFE" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Follow the latest looks, moments and stories." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow us" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to your Instagram link in Theme settings > Social media." },
    { "type": "range", "id": "speed", "label": "Scroll duration", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 60 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [
        { "type": "tile", "settings": { "caption": "Cold air" } },
        { "type": "tile", "settings": { "caption": "Heavyweight" } },
        { "type": "tile", "settings": { "caption": "Instagram" } },
        { "type": "tile", "settings": { "caption": "No Direction" } },
        { "type": "tile", "settings": { "caption": "01:17 AM" } }
      ]
    }
  ]
}
{% endschema %}
