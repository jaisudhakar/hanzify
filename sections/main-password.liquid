<section class="password color-{{ section.settings.color_scheme }}">
  <div class="password__media">
    {%- render 'media-image', image: section.settings.image, demo: 'demo-banner-stormy-peaks.webp', sizes: '100vw', width: 1672, height: 941, lazy: false, fallback: 'lifestyle-2' -%}
  </div>
  <div class="password__inner">
    <p class="label">{{ shop.name | escape }}</p>
    <h1 class="display h2">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
      <input id="PasswordNewsletter" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.label' | t }}" required>
      <button type="submit">{{ 'newsletter.button_label' | t }} {% render 'icon', icon: 'arrow' %}</button>
      {%- if form.posted_successfully? -%}<p class="newsletter__success" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="label">{{ 'templates.password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'account-form' -%}
        {%- if form.errors -%}<div class="errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="Password">{{ 'templates.password.password' | t }}</label>
        <input class="field" id="Password" type="password" name="password" autocomplete="current-password" required>
        <button class="btn btn--light" type="submit">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
      <p class="cart-note">{{ 'templates.password.admin_link_html' | t }}</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ]
}
{% endschema %}
