<section class="section section--tight-top">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="display h3" style="margin-bottom:24px">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'account-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'templates.contact.form.post_success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
      <input class="field" id="ContactForm-name" type="text" name="contact[{{ 'templates.contact.form.name' | t }}]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
      <label for="ContactForm-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
      <input class="field" id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
      <label for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
      <input class="field" id="ContactForm-phone" type="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" autocomplete="tel" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
      <label for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
      <textarea class="field" id="ContactForm-body" name="contact[{{ 'templates.contact.form.comment' | t }}]" rows="6">{{ form.body }}</textarea>
      <button type="submit" class="btn">{{ 'templates.contact.form.send' | t }} {% render 'icon', icon: 'arrow' %}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Write to us" }],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
